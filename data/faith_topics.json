[{"category":"Church","topic":"The Church","references":[{"label":"Mt 16:18-19","canonical":"MAT.16.18"},{"label":"Mt 18:17","canonical":"MAT.18.17"},{"label":"Mt 28:18-20","canonical":"MAT.28.18"},{"label":"Mk 16:15-16","canonical":"MRK.16.15"},{"label":"Lk 10:16","canonical":"LUK.10.16"},{"label":"Jn 14:16, 26","canonical":"JHN.14.16"},{"label":"Jn 16:13","canonical":"JHN.16.13"},{"label":"2 Pet 2:9","canonical":"2PE.2.9"},{"label":"1 Cor 3:10","canonical":"1CO.3.10"},{"label":"1 Tim 3:15","canonical":"1TI.3.15"}],"catholic_summary":"Christ founded and continually sustains one visible and spiritual Church, entrusted with teaching, sanctifying, and governing in his name.","ccc":"CCC 748–780, 811–870"},{"category":"Church","topic":"The Church as the Body of Christ","references":[{"label":"Col 1:18","canonical":"COL.1.18"},{"label":"1 Cor 6:15","canonical":"1CO.6.15"},{"label":"1 Cor 12:20-27","canonical":"1CO.12.20"},{"label":"Rom 12:4-5","canonical":"ROM.12.4"},{"label":"Eph 5:30","canonical":"EPH.5.30"}],"catholic_summary":"The Church is the Body of Christ: Christ is the Head and the baptized are members joined to him and to one another.","ccc":"CCC 787–795"},{"category":"Church","topic":"Unity of the Church","references":[{"label":"Jn 10:16","canonical":"JHN.10.16"},{"label":"Jn 17:17-23","canonical":"JHN.17.17"},{"label":"Jn 17:23","canonical":"JHN.17.23"},{"label":"Mt 16:18-19","canonical":"MAT.16.18"},{"label":"Mt 18:17","canonical":"MAT.18.17"},{"label":"1 Cor 1:10","canonical":"1CO.1.10"},{"label":"1 Cor 12:12-13","canonical":"1CO.12.12"},{"label":"Col 3:15","canonical":"COL.3.15"},{"label":"Rom 12:5","canonical":"ROM.12.5"},{"label":"Rom 16:17","canonical":"ROM.16.17"},{"label":"Rom 15:5","canonical":"ROM.15.5"},{"label":"Phil 2:2","canonical":"PHP.2.2"},{"label":"Eph 4:3-6","canonical":"EPH.4.3"},{"label":"Eph 4:4","canonical":"EPH.4.4"}],"catholic_summary":"Christ wills one Church, whose unity is expressed in one faith, common worship, apostolic succession, and bonds of charity.","ccc":"CCC 813–822"},{"category":"Church","topic":"Apostolic Church","references":[{"label":"Jn 15:16","canonical":"JHN.15.16"},{"label":"Jn 20:21","canonical":"JHN.20.21"},{"label":"Jn 10:16","canonical":"JHN.10.16"},{"label":"Mt 16:18","canonical":"MAT.16.18"},{"label":"Lk 22:29-3","canonical":"LUK.22.29"},{"label":"Lk 22:32","canonical":"LUK.22.32"},{"label":"Jn 21:17","canonical":"JHN.21.17"},{"label":"1 Tim 3:1, 8","canonical":"1TI.3.1"},{"label":"Eph 4:11","canonical":"EPH.4.11"},{"label":"Tit 1:5","canonical":"TIT.1.5"}],"catholic_summary":"The Church is apostolic because she is founded on the apostles, preserves their teaching, and is taught and governed by their successors.","ccc":"CCC 857–865"},{"category":"Church","topic":"Authority of the Church","references":[{"label":"Acts 2:42","canonical":"ACT.2.42"},{"label":"Mt 16:18, 20","canonical":"MAT.16.18"},{"label":"Mt 23:2","canonical":"MAT.23.2"},{"label":"Mt 28:18-20","canonical":"MAT.28.18"},{"label":"Mt 18:18","canonical":"MAT.18.18"},{"label":"Mt 18:17","canonical":"MAT.18.17"},{"label":"Jn 20:23","canonical":"JHN.20.23"},{"label":"Lk 10:16","canonical":"LUK.10.16"},{"label":"1 Tim 3:15","canonical":"1TI.3.15"},{"label":"1 Cor 5:5","canonical":"1CO.5.5"},{"label":"1 Tim 1:20","canonical":"1TI.1.20"},{"label":"1 Cor 11:23-24","canonical":"1CO.11.23"},{"label":"1 Rom 5","canonical":null},{"label":"Eph 5:25-26","canonical":"EPH.5.25"},{"label":"Heb 13:17","canonical":"HEB.13.17"}],"catholic_summary":"Christ entrusted the apostles and their successors with real authority to teach, sanctify, and govern the Church.","ccc":"CCC 84–87, 874–896"},{"category":"Church","topic":"Infallibility and the Church","references":[{"label":"Acts 15:28","canonical":"ACT.15.28"},{"label":"Jn 16:13","canonical":"JHN.16.13"},{"label":"Jn 14:26","canonical":"JHN.14.26"},{"label":"Mt 28:20","canonical":"MAT.28.20"},{"label":"Lk 10:16","canonical":"LUK.10.16"},{"label":"1 Jn 2:27","canonical":"1JN.2.27"},{"label":"1 Tim 3:15","canonical":"1TI.3.15"}],"catholic_summary":"Christ preserves his Church in the truth; the Magisterium exercises the charism of infallibility under defined conditions in matters of faith and morals.","ccc":"CCC 889–892"},{"category":"Church","topic":"Perpetuity of the Church","references":[{"label":"Mt 7:24","canonical":"MAT.7.24"},{"label":"Mt 13:24-30","canonical":"MAT.13.24"},{"label":"Mt 16:18","canonical":"MAT.16.18"},{"label":"Mt 28:19-20","canonical":"MAT.28.19"},{"label":"Jn 14:16","canonical":"JHN.14.16"},{"label":"Lk 1:32, 33","canonical":"LUK.1.32"},{"label":"Isa 9:6-7","canonical":"ISA.9.6"},{"label":"Dan 2:44","canonical":"DAN.2.44"},{"label":"Dan 7:14","canonical":"DAN.7.14"},{"label":"Eph 3:21","canonical":"EPH.3.21"}],"catholic_summary":"Christ remains with his Church and the Holy Spirit sustains her until the consummation of the world.","ccc":"CCC 768–780, 830–870"},{"category":"Papacy & Succession","topic":"Papacy and Infallibility","references":[{"label":"Acts 2:14-40","canonical":"ACT.2.14"},{"label":"Acts 3:6-7","canonical":"ACT.3.6"},{"label":"Acts 10:46-48","canonical":"ACT.10.46"},{"label":"Mt 10:1-4","canonical":"MAT.10.1"},{"label":"Mk 3:16-19","canonical":"MRK.3.16"},{"label":"Lk 6:14-16","canonical":"LUK.6.14"},{"label":"Acts 1:13","canonical":"ACT.1.13"},{"label":"Lk 9:32","canonical":"LUK.9.32"},{"label":"Mt 18:21, 8","canonical":"MAT.18.21"},{"label":"Lk 12:41","canonical":"LUK.12.41"},{"label":"Jn 6:69","canonical":"JHN.6.69"},{"label":"Mt 16:18-19","canonical":"MAT.16.18"},{"label":"Jn 1:42","canonical":"JHN.1.42"},{"label":"Jn 21:17","canonical":"JHN.21.17"},{"label":"Lk 22:31-32","canonical":"LUK.22.31"},{"label":"Lk 10:1-2, 16","canonical":"LUK.10.1"},{"label":"Jn 13:20","canonical":"JHN.13.20"},{"label":"2 Cor 5:20","canonical":"2CO.5.20"},{"label":"Gal 4:14","canonical":"GAL.4.14"},{"label":"Acts 5:1-5","canonical":"ACT.5.1"},{"label":"Mk 6:20","canonical":"MRK.6.20"},{"label":"Lk 1:70,2","canonical":"LUK.1.70"},{"label":"Rom 12:1","canonical":"ROM.12.1"},{"label":"1 Cor 7:14","canonical":"1CO.7.14"},{"label":"Eph 3:5","canonical":"EPH.3.5"},{"label":"Col 1:22","canonical":"COL.1.22"},{"label":"Isa 22:22","canonical":"ISA.22.22"},{"label":"Rev 1:18","canonical":"REV.1.18"}],"catholic_summary":"The Bishop of Rome, successor of Peter, has a unique pastoral office in the college of bishops; papal infallibility is limited to defined conditions of teaching faith and morals.","ccc":"CCC 880–892, 936–937"},{"category":"Papacy & Succession","topic":"Primacy of Peter","references":[{"label":"Acts 1:13-26","canonical":"ACT.1.13"},{"label":"Acts 2:14","canonical":"ACT.2.14"},{"label":"Acts 2:41","canonical":"ACT.2.41"},{"label":"Acts 3:6-7","canonical":"ACT.3.6"},{"label":"Acts 5:1-11","canonical":"ACT.5.1"},{"label":"Acts 8:21","canonical":"ACT.8.21"},{"label":"Acts 10:44-46","canonical":"ACT.10.44"},{"label":"Acts 15:7","canonical":"ACT.15.7"},{"label":"Acts 15:19","canonical":"ACT.15.19"},{"label":"Mt 16:18","canonical":"MAT.16.18"},{"label":"Mt 16:19","canonical":"MAT.16.19"},{"label":"Lk 22:32","canonical":"LUK.22.32"},{"label":"Lk 24:34","canonical":"LUK.24.34"},{"label":"Jn 21:17","canonical":"JHN.21.17"},{"label":"Mk 16:7","canonical":"MRK.16.7"},{"label":"Gal 1:18","canonical":"GAL.1.18"},{"label":"Gal 2:11-14","canonical":"GAL.2.11"},{"label":"Mt 10","canonical":null},{"label":"Mk 3:16-19","canonical":"MRK.3.16"},{"label":"Lk 6:14-16","canonical":"LUK.6.14"},{"label":"Acts 1:13","canonical":"ACT.1.13"},{"label":"Lk 9:32","canonical":"LUK.9.32"},{"label":"Mt 18:21","canonical":"MAT.18.21"},{"label":"Mk 8:29","canonical":"MRK.8.29"},{"label":"Lk 8:45","canonical":"LUK.8.45"},{"label":"Jn 6:69","canonical":"JHN.6.69"}],"catholic_summary":"Christ gave Peter a unique role among the Twelve, symbolized by the rock, keys, and commission to strengthen and shepherd the flock.","ccc":"CCC 551–553, 880–881"},{"category":"Papacy & Succession","topic":"Apostolic Succession","references":[{"label":"Acts 1:20","canonical":"ACT.1.20"},{"label":"Acts 1:25-26","canonical":"ACT.1.25"},{"label":"Acts 14:23","canonical":"ACT.14.23"},{"label":"2 Chr 19:11","canonical":"2CH.19.11"},{"label":"1 Cor 12:28-29","canonical":"1CO.12.28"},{"label":"1 Tim 3:1, 8","canonical":"1TI.3.1"},{"label":"1 Tim 4:14","canonical":"1TI.4.14"},{"label":"1 Tim 5:22","canonical":"1TI.5.22"},{"label":"2 Tim 2:2","canonical":"2TI.2.2"},{"label":"Mal 2:7","canonical":"MAL.2.7"},{"label":"Eph 2:20","canonical":"EPH.2.20"},{"label":"Eph 4:11","canonical":"EPH.4.11"}],"catholic_summary":"The apostolic ministry continues through bishops who succeed the apostles by sacramental ordination and communion.","ccc":"CCC 77, 861–862, 874–896"},{"category":"Church","topic":"False Teachers","references":[{"label":"Gal 1:6-10","canonical":"GAL.1.6"},{"label":"2 Cor 11:13-15","canonical":"2CO.11.13"}],"catholic_summary":"The Church must guard the deposit of faith against teaching that contradicts revealed truth.","ccc":"CCC 84–95, 2089"},{"category":"Scripture & Tradition","topic":"Sola Scriptura / Bible Alone","references":[{"label":"Acts 2:42","canonical":"ACT.2.42"},{"label":"Acts 8:31","canonical":"ACT.8.31"},{"label":"Heb 5:12","canonical":"HEB.5.12"},{"label":"Acts 20","canonical":null},{"label":"Jn 21:25","canonical":"JHN.21.25"},{"label":"Mk 13:31","canonical":"MRK.13.31"},{"label":"Mk 16:15","canonical":"MRK.16.15"},{"label":"Mt 23:2-3","canonical":"MAT.23.2"},{"label":"2 Jn 1:12","canonical":"2JN.1.12"},{"label":"3 Jn 1:13-14","canonical":"3JN.1.13"},{"label":"1 Pet 1:25","canonical":"1PE.1.25"},{"label":"2 Pet 1:20-21","canonical":"2PE.1.20"},{"label":"2 Pet 3:15-16","canonical":"2PE.3.15"},{"label":"1 Cor 11:2","canonical":"1CO.11.2"},{"label":"1 Cor 15:1-2","canonical":"1CO.15.1"},{"label":"2 Tim 1:13","canonical":"2TI.1.13"},{"label":"2 Tim 2:2","canonical":"2TI.2.2"},{"label":"Rom 10:17","canonical":"ROM.10.17"},{"label":"Mt 15:3","canonical":"MAT.15.3"},{"label":"Mk 7:9","canonical":"MRK.7.9"},{"label":"Col 2:8","canonical":"COL.2.8"}],"catholic_summary":"Catholic teaching receives Sacred Scripture and Sacred Tradition together as one sacred deposit of the Word of God, authentically interpreted by the Magisterium.","ccc":"CCC 74–83, 84–87, 95, 100, 113–114"},{"category":"Scripture & Tradition","topic":"Deuterocanonical Books","references":[{"label":"Heb 11:35","canonical":"HEB.11.35"},{"label":"1 Pet 1:6-7","canonical":"1PE.1.6"},{"label":"Wis 3:5-6","canonical":"WIS.3.5"},{"label":"Rom 1:18-32","canonical":"ROM.1.18"},{"label":"Wis 13:1-9","canonical":"WIS.13.1"},{"label":"Isa 7:14","canonical":"ISA.7.14"},{"label":"Mt 1:23","canonical":"MAT.1.23"},{"label":"Isa 40:3","canonical":"ISA.40.3"},{"label":"Mt 3:3","canonical":"MAT.3.3"},{"label":"Joel 2:30-31","canonical":"JOE.2.30"},{"label":"Acts 2:19-29","canonical":"ACT.2.19"},{"label":"Ps 95:7-9","canonical":"PSA.95.7"},{"label":"Heb 3:7-9","canonical":"HEB.3.7"},{"label":"Mt 26:16","canonical":"MAT.26.16"},{"label":"Wis 2:17-21","canonical":"WIS.2.17"}],"catholic_summary":"The Catholic canon contains forty-six Old Testament books, including the Deuterocanonical books received by the Church as inspired Scripture.","ccc":"CCC 120, 138"},{"category":"God & Christology","topic":"The Trinity","references":[{"label":"Mt 28:19","canonical":"MAT.28.19"},{"label":"Jn 1:1","canonical":"JHN.1.1"},{"label":"Jn 8:58-59","canonical":"JHN.8.58"},{"label":"Jn 10:30","canonical":"JHN.10.30"},{"label":"Jn 20:28","canonical":"JHN.20.28"},{"label":"Col 2:9","canonical":"COL.2.9"}],"catholic_summary":"The one God is eternally Father, Son, and Holy Spirit: three divine Persons, one divine nature.","ccc":"CCC 232–267"},{"category":"God & Christology","topic":"The Holy Spirit is a Divine Person","references":[{"label":"Jn 14:26","canonical":"JHN.14.26"},{"label":"Acts 5:3-4","canonical":"ACT.5.3"},{"label":"Acts 13:2","canonical":"ACT.13.2"},{"label":"Acts 20:28","canonical":"ACT.20.28"},{"label":"Lk 22:19","canonical":"LUK.22.19"},{"label":"Jn 20:22","canonical":"JHN.20.22"},{"label":"Acts 6:6","canonical":"ACT.6.6"},{"label":"Acts 13:3","canonical":"ACT.13.3"},{"label":"Acts 14:22","canonical":"ACT.14.22"},{"label":"1 Tim 4:14","canonical":"1TI.4.14"},{"label":"2 Tim 1:6","canonical":"2TI.1.6"},{"label":"Tit 1:5","canonical":"TIT.1.5"}],"catholic_summary":"The Holy Spirit is the third divine Person of the Trinity, consubstantial with the Father and the Son.","ccc":"CCC 683–747"},{"category":"Sacraments","topic":"Seven Sacraments Instituted by Christ","references":[{"label":"Mt 28:19","canonical":"MAT.28.19"},{"label":"Jn 4:1","canonical":"JHN.4.1"},{"label":"Jn 5:43","canonical":"JHN.5.43"},{"label":"Acts 8:14-17","canonical":"ACT.8.14"},{"label":"Heb 6:2","canonical":"HEB.6.2"},{"label":"Mt 26:26-29","canonical":"MAT.26.26"},{"label":"1 Cor 11:23","canonical":"1CO.11.23"},{"label":"John 20:21-23","canonical":"JHN.20.21"},{"label":"Mk 6:13","canonical":"MRK.6.13"},{"label":"James 5:14-15","canonical":"JAS.5.14"},{"label":"Acts 6:3-6","canonical":"ACT.6.3"},{"label":"1 Tim. 3:1","canonical":"1TI.3.1"},{"label":"1 Tim. 3:8-9","canonical":"1TI.3.8"},{"label":"1 Tim. 4:14-16","canonical":"1TI.4.14"},{"label":"1 Tim. 5:17-19","canonical":"1TI.5.17"},{"label":"Mt 19:10-11","canonical":"MAT.19.10"},{"label":"Eph 5:31-32","canonical":"EPH.5.31"},{"label":"Gen 14:18","canonical":"GEN.14.18"},{"label":"Ps 110:4","canonical":"PSA.110.4"},{"label":"Heb 7:1-17","canonical":"HEB.7.1"},{"label":"Ex 12:8, 46","canonical":"EXO.12.8"},{"label":"Acts 2:42","canonical":"ACT.2.42"},{"label":"Jn 1:29","canonical":"JHN.1.29"},{"label":"Jn 6:35-71","canonical":"JHN.6.35"},{"label":"Jn 4:31-34","canonical":"JHN.4.31"},{"label":"Mt 16:5-12","canonical":"MAT.16.5"},{"label":"Jn 6:32-58","canonical":"JHN.6.32"},{"label":"Mt 26:26-27","canonical":"MAT.26.26"},{"label":"Mk 14:22,24","canonical":"MRK.14.22"},{"label":"Lk 22:19-20","canonical":"LUK.22.19"}],"catholic_summary":"The seven sacraments are efficacious signs of grace entrusted by Christ to the Church for sanctification.","ccc":"CCC 1113–1131, 1210–1211"},{"category":"Sacraments","topic":"Infant Baptism","references":[{"label":"Acts 16:15, 16","canonical":"ACT.16.15"},{"label":"1 Cor 1:16","canonical":"1CO.1.16"},{"label":"Acts 16:31","canonical":"ACT.16.31"},{"label":"Acts 16:15","canonical":"ACT.16.15"},{"label":"Acts 16:33","canonical":"ACT.16.33"},{"label":"Mk 16:16","canonical":"MRK.16.16"},{"label":"Rom 6:4","canonical":"ROM.6.4"},{"label":"Mk 10:14","canonical":"MRK.10.14"},{"label":"Mt 8:5","canonical":"MAT.8.5"},{"label":"Mt 15:21","canonical":"MAT.15.21"},{"label":"Lk 7:1","canonical":"LUK.7.1"},{"label":"Lk 18:15","canonical":"LUK.18.15"},{"label":"1 Cor 15:21-22","canonical":"1CO.15.21"},{"label":"Col 2:11-12","canonical":"COL.2.11"}],"catholic_summary":"Because Baptism gives new birth and grace, the Church baptizes infants in the faith of the Church rather than withholding the gift until adulthood.","ccc":"CCC 1250–1252, 1282"},{"category":"Sacraments","topic":"Baptismal Regeneration","references":[{"label":"Jn 3:5","canonical":"JHN.3.5"},{"label":"Acts 2:38-39","canonical":"ACT.2.38"},{"label":"Acts 22:16","canonical":"ACT.22.16"},{"label":"Rom 6:4-46","canonical":"ROM.6.4"},{"label":"1 Cor 6:11","canonical":"1CO.6.11"},{"label":"1 Pet 3:21","canonical":"1PE.3.21"},{"label":"Heb 10:22","canonical":"HEB.10.22"},{"label":"Acts 19:5-6","canonical":"ACT.19.5"},{"label":"Acts 8:14-17","canonical":"ACT.8.14"},{"label":"2 Cor 1:21-22","canonical":"2CO.1.21"},{"label":"Eph 1:13","canonical":"EPH.1.13"},{"label":"Heb 6:2","canonical":"HEB.6.2"},{"label":"Acts 20:28","canonical":"ACT.20.28"},{"label":"Acts 6:6","canonical":"ACT.6.6"},{"label":"Acts 13:3","canonical":"ACT.13.3"},{"label":"Acts 14:22","canonical":"ACT.14.22"},{"label":"Jn 20:22","canonical":"JHN.20.22"},{"label":"Lk 22:19","canonical":"LUK.22.19"},{"label":"1 Tim 4:14","canonical":"1TI.4.14"},{"label":"2 Tim 1:6","canonical":"2TI.1.6"},{"label":"Tit 1:5","canonical":"TIT.1.5"},{"label":"Mt 19:5-6","canonical":"MAT.19.5"},{"label":"Mk 10:7-12","canonical":"MRK.10.7"},{"label":"Eph 5:22-32","canonical":"EPH.5.22"},{"label":"Heb 13","canonical":null},{"label":"Gen 1:27","canonical":"GEN.1.27"},{"label":"Rev 19:7","canonical":"REV.19.7"},{"label":"Hos 3:1","canonical":"HOS.3.1"},{"label":"Mark 10:4-12","canonical":"MRK.10.4"},{"label":"Mk 6:12-13","canonical":"MRK.6.12"}],"catholic_summary":"Baptism is not merely symbolic: by water and the Spirit it forgives sin, gives new life in Christ, and incorporates the baptized into the Church.","ccc":"CCC 1213, 1257, 1262–1274"},{"category":"Sacraments","topic":"Penance / Reconciliation / Confession","references":[{"label":"Acts 19:5-6","canonical":"ACT.19.5"},{"label":"Mt 9:2-8","canonical":"MAT.9.2"},{"label":"Mt 18:18","canonical":"MAT.18.18"},{"label":"Jn 20:23","canonical":"JHN.20.23"},{"label":"Jn 20:22","canonical":"JHN.20.22"},{"label":"Gen 2:7","canonical":"GEN.2.7"},{"label":"1 Jn 5:16","canonical":"1JN.5.16"},{"label":"2 Cor 5:17-20","canonical":"2CO.5.17"},{"label":"Rev 20:12","canonical":"REV.20.12"},{"label":"Mt 25:32-46","canonical":"MAT.25.32"},{"label":"2 Cor 5:10","canonical":"2CO.5.10"},{"label":"Rom 2:6-10, 13","canonical":"ROM.2.6"},{"label":"Gal 6:6-10","canonical":"GAL.6.6"},{"label":"Phil 2:12","canonical":"PHP.2.12"},{"label":"Lk 6:46","canonical":"LUK.6.46"},{"label":"Mt 7:21","canonical":"MAT.7.21"},{"label":"Mt 19:16-21","canonical":"MAT.19.16"},{"label":"Jn 5:29","canonical":"JHN.5.29"},{"label":"Jn 14:15","canonical":"JHN.14.15"},{"label":"1 Jn 2:3-4","canonical":"1JN.2.3"},{"label":"1 Jn 3:24","canonical":"1JN.3.24"},{"label":"1 Jn 5:3","canonical":"1JN.5.3"},{"label":"Mt 19:16-17","canonical":"MAT.19.16"},{"label":"1 Cor 9:27","canonical":"1CO.9.27"},{"label":"1 Cor 13:2","canonical":"1CO.13.2"},{"label":"1 Tim 5:8","canonical":"1TI.5.8"},{"label":"Gal 5:6","canonical":"GAL.5.6"},{"label":"Heb 10:26","canonical":"HEB.10.26"}],"catholic_summary":"Christ entrusted the ministry of reconciliation to the Church; sacramental confession, absolution, contrition, and satisfaction restore communion after sin.","ccc":"CCC 1422–1498"},{"category":"Salvation","topic":"Salvation: Past Event","references":[{"label":"2 Tim 1:9","canonical":"2TI.1.9"},{"label":"Rom 8:24","canonical":"ROM.8.24"},{"label":"Eph 2:5, 8","canonical":"EPH.2.5"},{"label":"Tit 3:5","canonical":"TIT.3.5"}],"catholic_summary":"Salvation begins in God’s grace and includes justification and new birth already received in Christ.","ccc":"CCC 1987–1995, 2017–2021"},{"category":"Salvation","topic":"Salvation: Present Process","references":[{"label":"1 Pet 1:9","canonical":"1PE.1.9"},{"label":"Phil 2:12","canonical":"PHP.2.12"}],"catholic_summary":"The Christian life is an ongoing response to grace involving conversion, sanctification, perseverance, and growth in charity.","ccc":"CCC 1996–2016, 2023–2029"},{"category":"Salvation","topic":"Salvation: Future Hope","references":[{"label":"Acts 15:11","canonical":"ACT.15.11"},{"label":"Mt 10:22","canonical":"MAT.10.22"},{"label":"Mt 24:1","canonical":"MAT.24.1"},{"label":"Mk 8:35","canonical":"MRK.8.35"},{"label":"Rom 5:9-10","canonical":"ROM.5.9"},{"label":"Rom 13:11","canonical":"ROM.13.11"},{"label":"1 Cor 5:5","canonical":"1CO.5.5"},{"label":"Heb 9:28","canonical":"HEB.9.28"}],"catholic_summary":"Christians hope for final salvation, resurrection, judgment, and eternal communion with God, persevering in grace to the end.","ccc":"CCC 161–162, 988–1060"},{"category":"Salvation","topic":"Faith and Good Works","references":[{"label":"Mt 7:21","canonical":"MAT.7.21"},{"label":"Mt 19:16-17","canonical":"MAT.19.16"},{"label":"Jn 14:21","canonical":"JHN.14.21"},{"label":"Rom 2:2-8","canonical":"ROM.2.2"},{"label":"Gal 5:4-6","canonical":"GAL.5.4"},{"label":"Eph 2:8-10","canonical":"EPH.2.8"},{"label":"Phil 2:12-13","canonical":"PHP.2.12"}],"catholic_summary":"Justification is by grace; living faith works through charity, and grace-enabled good works truly belong to Christian discipleship and growth in holiness.","ccc":"CCC 1814–1816, 1987–2011, 2016, 2025–2027"},{"category":"Salvation","topic":"Judgment According to Deeds","references":[{"label":"Rev 20:12-13","canonical":"REV.20.12"},{"label":"1 Pet 1:17","canonical":"1PE.1.17"},{"label":"2 Cor 5:10","canonical":"2CO.5.10"},{"label":"2 Cor 11:15","canonical":"2CO.11.15"},{"label":"Rom 2:2-8","canonical":"ROM.2.2"},{"label":"Col 3:24-25","canonical":"COL.3.24"},{"label":"Mt 7:21","canonical":"MAT.7.21"},{"label":"Mt 24:13","canonical":"MAT.24.13"},{"label":"1 Jn 5:16,17","canonical":"1JN.5.16"},{"label":"2 Pet 2:1","canonical":"2PE.2.1"},{"label":"2 Pet 2:20","canonical":"2PE.2.20"},{"label":"1 Cor 9:27","canonical":"1CO.9.27"},{"label":"1 Cor 10:11-12","canonical":"1CO.10.11"},{"label":"2 Tim 2:11-13","canonical":"2TI.2.11"},{"label":"Rom 11:22","canonical":"ROM.11.22"},{"label":"Phil 2:12","canonical":"PHP.2.12"},{"label":"Gal 5:4","canonical":"GAL.5.4"},{"label":"Heb 4:1","canonical":"HEB.4.1"},{"label":"Heb 6:4-6","canonical":"HEB.6.4"},{"label":"Heb 10:26-27","canonical":"HEB.10.26"}],"catholic_summary":"Each person is judged by Christ, and Scripture presents deeds as revealing the response to grace and love.","ccc":"CCC 1021–1022, 1038–1041"},{"category":"Salvation","topic":"Health and Wealth Gospel","references":[{"label":"Mk 10:28","canonical":"MRK.10.28"},{"label":"1 Pet 1:6","canonical":"1PE.1.6"},{"label":"1 Pet 2:19-21","canonical":"1PE.2.19"},{"label":"Rom 8:16-17","canonical":"ROM.8.16"},{"label":"Rom 8:18","canonical":"ROM.8.18"},{"label":"Phil 1:28-29","canonical":"PHP.1.28"},{"label":"Col 1:24","canonical":"COL.1.24"},{"label":"Heb 12:5-7","canonical":"HEB.12.5"},{"label":"Heb 12:11","canonical":"HEB.12.11"}],"catholic_summary":"Christian discipleship does not promise earthly prosperity or freedom from suffering; union with Christ can include poverty, trial, and participation in his Cross.","ccc":"CCC 618, 1500–1505, 2544–2547"},{"category":"Mary","topic":"Mary","references":[{"label":"Rev 12:5","canonical":"REV.12.5"},{"label":"Lk 1:28, 30","canonical":"LUK.1.28"},{"label":"Lk 1:42-48","canonical":"LUK.1.42"},{"label":"Lk 1:43","canonical":"LUK.1.43"},{"label":"Lk 1:48","canonical":"LUK.1.48"},{"label":"Jn 2:1-5","canonical":"JHN.2.1"},{"label":"2 Tim 4:8","canonical":"2TI.4.8"},{"label":"1 Pet 5:4","canonical":"1PE.5.4"},{"label":"Rev 2:10","canonical":"REV.2.10"}],"catholic_summary":"Mary is the Mother of Christ and Mother of the Church, uniquely graced by God and honored by a devotion essentially different from worship owed to God.","ccc":"CCC 484–511, 963–975"},{"category":"Mary","topic":"Mary, Mother of God","references":[{"label":"Mt 1:23","canonical":"MAT.1.23"},{"label":"Lk 1:43","canonical":"LUK.1.43"},{"label":"Lk 1:35","canonical":"LUK.1.35"},{"label":"Gal 4:4","canonical":"GAL.4.4"}],"catholic_summary":"Because the one born of Mary is the eternal Son truly made man, the Church rightly confesses Mary as Mother of God (Theotokos).","ccc":"CCC 466, 484–495, 509"},{"category":"Mary","topic":"Assumption and Coronation of Mary","references":[{"label":"Gen 5:24","canonical":"GEN.5.24"},{"label":"Rev 11:19-21","canonical":"REV.11.19"},{"label":"Mt 27:52","canonical":"MAT.27.52"},{"label":"2 Tim 4:8","canonical":"2TI.4.8"},{"label":"1 Pet 5:4","canonical":"1PE.5.4"},{"label":"Rev 2:10","canonical":"REV.2.10"},{"label":"1 Cor 15:52","canonical":"1CO.15.52"},{"label":"Rom 6:23","canonical":"ROM.6.23"},{"label":"Heb 12:22","canonical":"HEB.12.22"},{"label":"Ps 132:8","canonical":"PSA.132.8"},{"label":"Mt 25:31","canonical":"MAT.25.31"}],"catholic_summary":"At the end of her earthly life Mary was taken body and soul into heavenly glory, a singular participation in her Son’s Resurrection and a sign of the Church’s destiny.","ccc":"CCC 966, 974"},{"category":"Mary","topic":"Immaculate Conception","references":[{"label":"Ex 25:11-21","canonical":"EXO.25.11"},{"label":"Gen 3:15","canonical":"GEN.3.15"},{"label":"Lk 1:28","canonical":"LUK.1.28"},{"label":"Lk 1:30","canonical":"LUK.1.30"},{"label":"Lk 1:37","canonical":"LUK.1.37"},{"label":"Lk 1:47","canonical":"LUK.1.47"},{"label":"Rom 3:23","canonical":"ROM.3.23"}],"catholic_summary":"By a singular grace of God in view of Christ’s merits, Mary was preserved from original sin from the first moment of her conception.","ccc":"CCC 490–493, 508"},{"category":"Mary","topic":"Perpetual Virginity of Mary","references":[{"label":"Gen 14:14","canonical":"GEN.14.14"},{"label":"Gen 11:26-28","canonical":"GEN.11.26"},{"label":"Gen 29:15","canonical":"GEN.29.15"},{"label":"Ex 13:2","canonical":"EXO.13.2"},{"label":"Num 3:12","canonical":"NUM.3.12"},{"label":"Ex 34:20","canonical":"EXO.34.20"},{"label":"Mk 6:3","canonical":"MRK.6.3"},{"label":"Mk 3:21","canonical":"MRK.3.21"},{"label":"Mt 1:25","canonical":"MAT.1.25"},{"label":"Mt 13:55-56","canonical":"MAT.13.55"},{"label":"Mt 27:56","canonical":"MAT.27.56"},{"label":"Mt 28:20","canonical":"MAT.28.20"},{"label":"Jn 7:3-4","canonical":"JHN.7.3"},{"label":"Jn 19:25","canonical":"JHN.19.25"},{"label":"Jn 19:26-27","canonical":"JHN.19.26"},{"label":"Lk 1:34","canonical":"LUK.1.34"},{"label":"Lk 2:41-51","canonical":"LUK.2.41"},{"label":"Lk 1:80","canonical":"LUK.1.80"},{"label":"1 Tim 4:13","canonical":"1TI.4.13"},{"label":"2 Sam 6:23","canonical":"2SA.6.23"},{"label":"Gen 8:7","canonical":"GEN.8.7"},{"label":"1 Cor 15:25","canonical":"1CO.15.25"}],"catholic_summary":"The Church confesses Mary’s real and perpetual virginity before, during, and after the birth of Christ.","ccc":"CCC 496–507, 510"},{"category":"Priesthood & Discipline","topic":"Priesthood and Worship","references":[{"label":"Rev 4:8","canonical":"REV.4.8"},{"label":"Rev 8:3-4","canonical":"REV.8.3"},{"label":"Gen 14:18","canonical":"GEN.14.18"},{"label":"Ps 110:4","canonical":"PSA.110.4"},{"label":"Heb 7:1-17","canonical":"HEB.7.1"},{"label":"Acts 1:15-26","canonical":"ACT.1.15"},{"label":"2 Tim 2:2","canonical":"2TI.2.2"},{"label":"Tit 1:5","canonical":"TIT.1.5"},{"label":"Acts 15:6,23","canonical":"ACT.15.6"},{"label":"1 Tim 4:14, 5","canonical":"1TI.4.14"},{"label":"1 Tim 5:17","canonical":"1TI.5.17"},{"label":"Lk 16:24","canonical":"LUK.16.24"},{"label":"Rom 4","canonical":null},{"label":"1 Cor 4:14-15","canonical":"1CO.4.14"},{"label":"Acts 7:2","canonical":"ACT.7.2"},{"label":"1 Jn 2:13-14","canonical":"1JN.2.13"},{"label":"1 Cor 7:7-9","canonical":"1CO.7.7"},{"label":"1 Cor 12","canonical":null},{"label":"2 Chr 6:13","canonical":"2CH.6.13"},{"label":"Ezra 9:5","canonical":"EZ.9.5"},{"label":"Mt 17:14","canonical":"MAT.17.14"},{"label":"Lk 5:8","canonical":"LUK.5.8"},{"label":"Rom 15:16","canonical":"ROM.15.16"}],"catholic_summary":"Christ is the one High Priest; his priesthood is shared differently by all the baptized and by ordained ministers who act sacramentally in his name.","ccc":"CCC 784, 1141–1142, 1536, 1544–1553, 1562–1568"},{"category":"Priesthood & Discipline","topic":"“Call No Man Father”","references":[{"label":"Acts 7:2","canonical":"ACT.7.2"},{"label":"Acts 21:40, 22","canonical":"ACT.21.40"},{"label":"Mt 3:9","canonical":"MAT.3.9"},{"label":"Lk 14:26","canonical":"LUK.14.26"},{"label":"1 Jn 2:13, 14","canonical":"1JN.2.13"},{"label":"1 Cor 4:14-15","canonical":"1CO.4.14"},{"label":"Mt 23:4","canonical":"MAT.23.4"},{"label":"Gal 4:1","canonical":"GAL.4.1"},{"label":"Rom 4:1","canonical":"ROM.4.1"},{"label":"1 Tim 1:2","canonical":"1TI.1.2"},{"label":"Tit 1:4","canonical":"TIT.1.4"},{"label":"Rom 4:16-17","canonical":"ROM.4.16"},{"label":"Heb 12:7-9","canonical":"HEB.12.7"},{"label":"Phil 10","canonical":null}],"catholic_summary":"Christian spiritual fatherhood does not replace God’s fatherhood; ordained ministry serves in Christ’s name and remains wholly dependent on him.","ccc":"CCC 1548–1551, 2034"},{"category":"Priesthood & Discipline","topic":"Priestly Celibacy","references":[{"label":"Mt 19:12","canonical":"MAT.19.12"},{"label":"1 Tim 4:1-3","canonical":"1TI.4.1"},{"label":"1 Tim 3:2","canonical":"1TI.3.2"},{"label":"1 Tim 5:9-12","canonical":"1TI.5.9"},{"label":"2 Tim 2:3-4","canonical":"2TI.2.3"},{"label":"1 Cor 7:8","canonical":"1CO.7.8"},{"label":"1 Cor 7:32-35","canonical":"1CO.7.32"},{"label":"Eph 5:21-33","canonical":"EPH.5.21"},{"label":"Jer 16:1-4","canonical":"JER.16.1"}],"catholic_summary":"In the Latin Church, priests are ordinarily chosen from men who freely embrace celibacy for the sake of the Kingdom; Eastern Catholic disciplines differ.","ccc":"CCC 1579–1580"},{"category":"Last Things","topic":"Purgatory","references":[{"label":"Rev 21:27","canonical":"REV.21.27"},{"label":"Mt 5:48","canonical":"MAT.5.48"},{"label":"Mt 5:26","canonical":"MAT.5.26"},{"label":"Mt 12:32","canonical":"MAT.12.32"},{"label":"Mt 12:36","canonical":"MAT.12.36"},{"label":"Lk 12:59","canonical":"LUK.12.59"},{"label":"1 Cor 3:15","canonical":"1CO.3.15"},{"label":"1 Pet 1:7","canonical":"1PE.1.7"},{"label":"Mt 5:25-26","canonical":"MAT.5.25"},{"label":"1 Jn 5:14-17","canonical":"1JN.5.14"},{"label":"1 Cor 15:29-30","canonical":"1CO.15.29"},{"label":"1 Pet 3:18-20","canonical":"1PE.3.18"},{"label":"2 Tim 1:15-18","canonical":"2TI.1.15"},{"label":"2 Sam 12:13-14","canonical":"2SA.12.13"},{"label":"Heb 12:14","canonical":"HEB.12.14"},{"label":"Heb 12:6-11","canonical":"HEB.12.6"},{"label":"Heb 12:23","canonical":"HEB.12.23"},{"label":"Col 1:24","canonical":"COL.1.24"},{"label":"2 Sam 12:14","canonical":"2SA.12.14"}],"catholic_summary":"Those who die in God’s grace but still need purification undergo a final purification distinct from the punishment of the damned.","ccc":"CCC 1030–1032, 1472"},{"category":"Last Things","topic":"Hell","references":[{"label":"Mt 25:41","canonical":"MAT.25.41"},{"label":"Mt 25:46","canonical":"MAT.25.46"},{"label":"Lk 3:16-17","canonical":"LUK.3.16"},{"label":"Isa 33:11, 14","canonical":"ISA.33.11"}],"catholic_summary":"Hell is the definitive self-exclusion from communion with God of those who die in mortal sin without repentance.","ccc":"CCC 1033–1037"},{"category":"Last Things","topic":"Original Sin","references":[{"label":"Gen 2:16-17","canonical":"GEN.2.16"},{"label":"Gen 3:11-19","canonical":"GEN.3.11"},{"label":"1 Cor 15:21-23","canonical":"1CO.15.21"},{"label":"Rom 5:12-19","canonical":"ROM.5.12"},{"label":"Eph 2:1-3","canonical":"EPH.2.1"},{"label":"Ps 51:5-7","canonical":"PSA.51.5"}],"catholic_summary":"Humanity inherits a fallen condition deprived of original holiness, not personal guilt for Adam’s act; Baptism remits original sin.","ccc":"CCC 385–421, 1250"},{"category":"Last Things","topic":"Forgiveness of Sins","references":[{"label":"Jn 20:22-23","canonical":"JHN.20.22"},{"label":"Mt 18:18","canonical":"MAT.18.18"},{"label":"2 Cor 5:18","canonical":"2CO.5.18"}],"catholic_summary":"God alone forgives sins, and the risen Christ entrusted his Church with a sacramental ministry of forgiveness and reconciliation.","ccc":"CCC 976–987, 1422–1498"},{"category":"Moral Teaching","topic":"Divorce and Remarriage","references":[{"label":"Mt 5:32-33","canonical":"MAT.5.32"},{"label":"Mt 19:4-6, 9","canonical":"MAT.19.4"},{"label":"Lk 16:18","canonical":"LUK.16.18"},{"label":"1 Cor 7:10-11","canonical":"1CO.7.10"},{"label":"Rom 7:2-3","canonical":"ROM.7.2"},{"label":"Mal 2:14-16","canonical":"MAL.2.14"}],"catholic_summary":"Sacramental marriage is ordered to lifelong unity and indissolubility; civil divorce and attempted remarriage do not dissolve a valid sacramental bond.","ccc":"CCC 1614–1615, 1644–1651, 2382–2386"},{"category":"Moral Teaching","topic":"Contraception","references":[{"label":"Gen 38:9-10","canonical":"GEN.38.9"},{"label":"Gen 1:27-28","canonical":"GEN.1.27"},{"label":"Gen 9:1, 35","canonical":"GEN.9.1"},{"label":"Ex 23:25-26","canonical":"EXO.23.25"},{"label":"Acts 5:1-11","canonical":"ACT.5.1"},{"label":"Mt 21:19","canonical":"MAT.21.19"},{"label":"Mk 11:14","canonical":"MRK.11.14"},{"label":"1 Cor 6:19-20","canonical":"1CO.6.19"},{"label":"1 Chr 25:5","canonical":"1CH.25.5"},{"label":"1 Chr 26:4-5","canonical":"1CH.26.4"},{"label":"1 Tim 2:11-15","canonical":"1TI.2.11"},{"label":"Rom 1:25-27","canonical":"ROM.1.25"},{"label":"Hos 9:10-17","canonical":"HOS.9.10"},{"label":"Lev 21:17-20","canonical":"LEV.21.17"},{"label":"Gal 6:7","canonical":"GAL.6.7"},{"label":"Gal 5:20","canonical":"GAL.5.20"},{"label":"Rev 9:21, 21","canonical":"REV.9.21"},{"label":"Lev 20:13","canonical":"LEV.20.13"},{"label":"Lev 20:15","canonical":"LEV.20.15"},{"label":"Lev 20:16","canonical":"LEV.20.16"},{"label":"Ps 127:3-5","canonical":"PSA.127.3"}],"catholic_summary":"Marital love must remain open to life; actions intended to render procreation impossible are contrary to the inseparable unitive and procreative meanings of marriage.","ccc":"CCC 2366–2372"},{"category":"Moral Teaching","topic":"Homosexuality","references":[{"label":"Gen 1:27","canonical":"GEN.1.27"},{"label":"Gen 2:21-24","canonical":"GEN.2.21"},{"label":"Gen 19","canonical":null},{"label":"1 Cor 6:9","canonical":"1CO.6.9"},{"label":"1 Tim 1:9-10","canonical":"1TI.1.9"},{"label":"Rom 1:27","canonical":"ROM.1.27"},{"label":"Lev 18:22","canonical":"LEV.18.22"},{"label":"Lev 20:13","canonical":"LEV.20.13"}],"catholic_summary":"The Church distinguishes persons from acts: every person must be treated with dignity and compassion, while homosexual acts are not morally approved.","ccc":"CCC 2357–2359"},{"category":"Moral Teaching","topic":"Alcohol / Wine","references":[{"label":"Gen 27:25","canonical":"GEN.27.25"},{"label":"Jn 2:2-10","canonical":"JHN.2.2"},{"label":"Lk 7:33-34","canonical":"LUK.7.33"},{"label":"1 Tim 5:23","canonical":"1TI.5.23"},{"label":"Prov 20:1","canonical":"PRO.20.1"},{"label":"Eccl 9:7","canonical":"ECC.9.7"},{"label":"Isa 25:6","canonical":"ISA.25.6"},{"label":"Isa 5:11","canonical":"ISA.5.11"},{"label":"Isa 5:22","canonical":"ISA.5.22"},{"label":"Eph 5:18","canonical":"EPH.5.18"},{"label":"Jn 15:1-8","canonical":"JHN.15.1"},{"label":"Dan 8:17","canonical":"DAN.8.17"},{"label":"Tob 12:16","canonical":"TOB.12.16"},{"label":"Mt 18:10","canonical":"MAT.18.10"},{"label":"1 Cor 13:12","canonical":"1CO.13.12"},{"label":"1 John 3:2","canonical":null},{"label":"Lk 20:34-38","canonical":"LUK.20.34"},{"label":"2 Tim 4:8","canonical":"2TI.4.8"},{"label":"1 Pet 5:4","canonical":"1PE.5.4"},{"label":"Rev 2:10","canonical":"REV.2.10"}],"catholic_summary":"Alcohol is not intrinsically forbidden, but temperance is required and drunkenness or abuse that endangers oneself or others is gravely wrong.","ccc":"CCC 1809, 2290"},{"category":"Saints & Devotion","topic":"Communion of Saints","references":[{"label":"1 Cor 12:12-27","canonical":"1CO.12.12"},{"label":"Rom 12:5","canonical":"ROM.12.5"},{"label":"Rom 8:35-39","canonical":"ROM.8.35"},{"label":"Rom 12:10","canonical":"ROM.12.10"},{"label":"Eph 1:22-23","canonical":"EPH.1.22"},{"label":"Eph 5:21-32","canonical":"EPH.5.21"},{"label":"Eph 4:4","canonical":"EPH.4.4"},{"label":"Col 3:15","canonical":"COL.3.15"},{"label":"Col 1:18, 24","canonical":"COL.1.18"},{"label":"Gal 6:2","canonical":"GAL.6.2"},{"label":"Gal 6:10","canonical":"GAL.6.10"}],"catholic_summary":"All who belong to Christ form one communion embracing the faithful on earth, those being purified, and the blessed in heaven.","ccc":"CCC 946–962"},{"category":"Saints & Devotion","topic":"Intercessory Prayer of Saints","references":[{"label":"Rev 8:3-4","canonical":"REV.8.3"},{"label":"Jer 15:1","canonical":"JER.15.1"},{"label":"Rev 1:6, 5","canonical":"REV.1.6"},{"label":"Rev 5:8","canonical":"REV.5.8"},{"label":"Rev 6:9-11","canonical":"REV.6.9"},{"label":"Rev 20:4","canonical":"REV.20.4"},{"label":"Wis 3:1-6","canonical":"WIS.3.1"},{"label":"Jn 10:11-16","canonical":"JHN.10.11"},{"label":"Jn 21:15-16","canonical":"JHN.21.15"},{"label":"Mt 25:23","canonical":"MAT.25.23"},{"label":"Mk 10:18","canonical":"MRK.10.18"},{"label":"Mk 12:25","canonical":"MRK.12.25"},{"label":"Mt 22:30","canonical":"MAT.22.30"},{"label":"Mk 12:26-27","canonical":"MRK.12.26"},{"label":"Mk 9:4","canonical":"MRK.9.4"},{"label":"Lk 9:31","canonical":"LUK.9.31"},{"label":"Lk 16:19-30","canonical":"LUK.16.19"},{"label":"1 John 4:20-21","canonical":null},{"label":"1 Cor 12:21","canonical":"1CO.12.21"},{"label":"1 Cor 13:12","canonical":"1CO.13.12"},{"label":"1 Tim 2:5","canonical":"1TI.2.5"},{"label":"1 Tim 2:1-7","canonical":"1TI.2.1"},{"label":"1 Pet 2:5","canonical":"1PE.2.5"},{"label":"Rom 15:30","canonical":"ROM.15.30"},{"label":"Col 4:3, 1","canonical":"COL.4.3"},{"label":"2 Macc 15:7-16","canonical":"2MA.15.7"},{"label":"Tob 12:12","canonical":"TOB.12.12"},{"label":"Zech 1:12","canonical":"ZEC.1.12"},{"label":"Eph 6:18","canonical":"EPH.6.18"},{"label":"Col 4:3","canonical":"COL.4.3"}],"catholic_summary":"The saints in heaven remain united to Christ and the Church and intercede for the faithful; their intercession depends entirely on Christ’s unique mediation.","ccc":"CCC 956, 969–970, 2634–2636, 2683"},{"category":"Saints & Devotion","topic":"Veneration of Saints","references":[{"label":"Mt 18:10","canonical":"MAT.18.10"},{"label":"1 Jn 3:2","canonical":"1JN.3.2"},{"label":"Dan 8:17","canonical":"DAN.8.17"},{"label":"Tob 12:16","canonical":"TOB.12.16"},{"label":"Heb 13:7","canonical":"HEB.13.7"}],"catholic_summary":"The Church honors the saints as works of God’s grace and examples of holiness; veneration is categorically distinct from adoration owed to God alone.","ccc":"CCC 828, 956–957, 1173, 2683"},{"category":"Saints & Devotion","topic":"Relics","references":[{"label":"Acts 5:15-16","canonical":"ACT.5.15"},{"label":"Acts 19:11-12","canonical":"ACT.19.11"},{"label":"Mt 9:20-22","canonical":"MAT.9.20"},{"label":"2 Kgs 13:20-21","canonical":"2KI.13.20"}],"catholic_summary":"Catholic devotion may honor relics of the saints as part of popular piety while directing all authentic devotion toward God.","ccc":"CCC 956–957, 1674"},{"category":"Saints & Devotion","topic":"Sacred Images and Statues","references":[{"label":"Ex 25:18-22, 26","canonical":"EXO.25.18"},{"label":"Num 21:8-9","canonical":"NUM.21.8"},{"label":"Ex 20:4-5","canonical":"EXO.20.4"},{"label":"Ex 25:18-19","canonical":"EXO.25.18"},{"label":"1 Kgs 6:23-29, 32","canonical":"1KI.6.23"},{"label":"1 Kgs 7:25-45","canonical":"1KI.7.25"},{"label":"Jn 4:22","canonical":"JHN.4.22"},{"label":"Jn 20:24-25","canonical":"JHN.20.24"},{"label":"Mt 13:24-30","canonical":"MAT.13.24"},{"label":"Mt 13:47-48","canonical":"MAT.13.47"},{"label":"Mk 14:43-46","canonical":"MRK.14.43"},{"label":"Mk 14:66-72","canonical":"MRK.14.66"},{"label":"Mk 14:50","canonical":"MRK.14.50"},{"label":"2 Kgs 23:7","canonical":"2KI.23.7"},{"label":"2 Tim 2:13","canonical":"2TI.2.13"},{"label":"Rom 3:3-4","canonical":"ROM.3.3"},{"label":"Jer 32:32-35","canonical":"JER.32.32"}],"catholic_summary":"The Incarnation grounds Christian sacred imagery; honor shown to an image passes to the person represented and is distinct from adoration of God.","ccc":"CCC 1159–1162, 2129–2132"},{"category":"Priesthood & Discipline","topic":"Fasting","references":[{"label":"Mt 9:15","canonical":"MAT.9.15"},{"label":"Mt 6:16-18","canonical":"MAT.6.16"},{"label":"Mk 7:19","canonical":"MRK.7.19"},{"label":"1 Tim 4:3","canonical":"1TI.4.3"},{"label":"1 Tim 4:4-5","canonical":"1TI.4.4"},{"label":"Dan 10:3","canonical":"DAN.10.3"}],"catholic_summary":"Fasting is a biblical penitential practice that expresses conversion, self-discipline, prayer, and solidarity with the poor.","ccc":"CCC 1434, 2043"},{"category":"God & Christology","topic":"Divinity of Jesus","references":[{"label":"Acts 20:28","canonical":"ACT.20.28"},{"label":"Jn 1:1","canonical":"JHN.1.1"},{"label":"Jn 1:14-15","canonical":"JHN.1.14"},{"label":"Jn 8:19","canonical":"JHN.8.19"},{"label":"Jn 8:58-59","canonical":"JHN.8.58"},{"label":"Jn 10:30-33","canonical":"JHN.10.30"},{"label":"Ex 3:14, 20","canonical":"EXO.3.14"},{"label":"Lev 19:12, 24","canonical":"LEV.19.12"},{"label":"Jn 10:38","canonical":"JHN.10.38"},{"label":"Jn 12:45","canonical":"JHN.12.45"},{"label":"Jn 14:8-12","canonical":"JHN.14.8"},{"label":"Jn 20:28","canonical":"JHN.20.28"},{"label":"1 Jn 1:7","canonical":"1JN.1.7"},{"label":"Col 2:9","canonical":"COL.2.9"},{"label":"Eph 1:7","canonical":"EPH.1.7"},{"label":"Tit 2:13","canonical":"TIT.2.13"}],"catholic_summary":"Jesus Christ is the eternal Son, true God and true man, consubstantial with the Father in his divinity.","ccc":"CCC 430–455, 464–469"},{"category":"Last Things","topic":"Time of the Second Coming Is Unknown","references":[{"label":"Rev 3:3","canonical":"REV.3.3"},{"label":"Acts 8:29","canonical":"ACT.8.29"},{"label":"Acts 13:2","canonical":"ACT.13.2"},{"label":"Jn 14:26","canonical":"JHN.14.26"},{"label":"Mt 24:36","canonical":"MAT.24.36"},{"label":"Mt 24:44","canonical":"MAT.24.44"},{"label":"Mt 25:13","canonical":"MAT.25.13"},{"label":"Mk 13:35-37","canonical":"MRK.13.35"},{"label":"Lk 12:46","canonical":"LUK.12.46"},{"label":"1 Cor 2:11","canonical":"1CO.2.11"},{"label":"1 Cor 12:11","canonical":"1CO.12.11"},{"label":"2 Pet 3:9-10","canonical":"2PE.3.9"},{"label":"Rom 8:27","canonical":"ROM.8.27"},{"label":"Eph 4:30","canonical":"EPH.4.30"}],"catholic_summary":"Christ will return in glory, but the time is not revealed for human calculation; Christians remain watchful and faithful.","ccc":"CCC 668–682, especially 673–677"},{"category":"Saints & Devotion","topic":"Repetitious Prayer","references":[{"label":"Rev 4:8","canonical":"REV.4.8"},{"label":"Mt 6:7","canonical":"MAT.6.7"},{"label":"Mt 6:9-13","canonical":"MAT.6.9"},{"label":"Mt 26:44","canonical":"MAT.26.44"},{"label":"Lk 18:13","canonical":"LUK.18.13"},{"label":"1 Kgs 18:25-29","canonical":"1KI.18.25"},{"label":"Ps 136","canonical":null}],"catholic_summary":"Jesus condemns empty, superstitious multiplication of words, not persevering or repeated prayer offered with faith and attention.","ccc":"CCC 2708, 2742–2745"},{"category":"Last Things","topic":"Prayer for the Dead","references":[{"label":"2 Tim 1:15-18","canonical":"2TI.1.15"},{"label":"Jn 19:25","canonical":"JHN.19.25"},{"label":"Mk 15:47","canonical":"MRK.15.47"},{"label":"Mt 27:56","canonical":"MAT.27.56"},{"label":"Mk 6:3","canonical":"MRK.6.3"},{"label":"Acts 1:12-15","canonical":"ACT.1.12"},{"label":"Gen 14:14","canonical":"GEN.14.14"},{"label":"Gen 11:26-28","canonical":"GEN.11.26"},{"label":"Gen 29:15","canonical":"GEN.29.15"},{"label":"John 19:26-27","canonical":"JHN.19.26"},{"label":"2 Sam 6:23","canonical":"2SA.6.23"},{"label":"Gen 8:7","canonical":"GEN.8.7"}],"catholic_summary":"From earliest times the Church has prayed for the dead, especially in the Eucharistic sacrifice, asking purification and entrance into the beatific vision.","ccc":"CCC 958, 1030–1032"},{"category":"Salvation","topic":"Justification Is Not Merely Forensic or Imputed","references":[{"label":"1 Jn 1:7, 2","canonical":"1JN.1.7"},{"label":"Jn 1:29","canonical":"JHN.1.29"},{"label":"Heb 9:26-28","canonical":"HEB.9.26"},{"label":"Ps 50:3","canonical":"PSA.50.3"},{"label":"Ps 102:12","canonical":"PSA.102.12"},{"label":"Isa 43:25","canonical":"ISA.43.25"},{"label":"Rom 2:13","canonical":"ROM.2.13"},{"label":"Rom 3:20","canonical":"ROM.3.20"},{"label":"Heb 11:8","canonical":"HEB.11.8"},{"label":"Gen 12:1-4","canonical":"GEN.12.1"},{"label":"Rom 4:2-3","canonical":"ROM.4.2"},{"label":"Gen 15:6","canonical":"GEN.15.6"},{"label":"Gen 22:1-18","canonical":"GEN.22.1"},{"label":"2 Pet 1:4","canonical":"2PE.1.4"}],"catholic_summary":"Justification is God’s gracious work that forgives sins and truly renews the interior person through sanctifying grace and participation in divine life.","ccc":"CCC 1987–1995, 1999–2000"},{"category":"Moral Teaching","topic":"Abortion","references":[{"label":"Job 31:15","canonical":"JOB.31.15"},{"label":"Ps 22:9-10","canonical":"PSA.22.9"},{"label":"Ps 139:13-16","canonical":"PSA.139.13"},{"label":"Isa 44:2","canonical":"ISA.44.2"},{"label":"Isa 49:5","canonical":"ISA.49.5"},{"label":"Isa 46:3-4","canonical":"ISA.46.3"},{"label":"Jer 1:4-5","canonical":"JER.1.4"},{"label":"Lk 1:41","canonical":"LUK.1.41"},{"label":"Ex 20:13","canonical":"EXO.20.13"},{"label":"Ps 82:3-4","canonical":"PSA.82.3"},{"label":"Prov 24:11-12","canonical":"PRO.24.11"},{"label":"Gal 5:20","canonical":"GAL.5.20"},{"label":"Rev 9:2","canonical":"REV.9.2"},{"label":"Rev 21:8","canonical":"REV.21.8"},{"label":"Mt 19:12","canonical":"MAT.19.12"},{"label":"1 Cor 7:7-9","canonical":"1CO.7.7"},{"label":"1 Cor 7:32-33","canonical":"1CO.7.32"},{"label":"1 Tim 5:9-12","canonical":"1TI.5.9"},{"label":"Jer 16:1-4","canonical":"JER.16.1"},{"label":"Mt 6:16-18","canonical":"MAT.6.16"},{"label":"Mt 9:15","canonical":"MAT.9.15"},{"label":"Mk 7:19","canonical":"MRK.7.19"},{"label":"1 Tim 4:4-5","canonical":"1TI.4.4"}],"catholic_summary":"Human life must be respected and protected absolutely from conception; direct abortion is gravely contrary to the moral law.","ccc":"CCC 2270–2275"},{"category":"Saints & Devotion","topic":"Worship","references":[{"label":"Rev 4:8","canonical":"REV.4.8"},{"label":"2 Chr 6:13","canonical":"2CH.6.13"},{"label":"Ezra 9:5","canonical":"EZ.9.5"},{"label":"Mt 17:14","canonical":"MAT.17.14"},{"label":"Lk 5:8","canonical":"LUK.5.8"},{"label":"Rev 5:8","canonical":"REV.5.8"},{"label":"1 Cor 12","canonical":null},{"label":"Heb 13:10","canonical":"HEB.13.10"},{"label":"Rev 8:3","canonical":"REV.8.3"},{"label":"Rev 4:4","canonical":"REV.4.4"}],"catholic_summary":"Adoration belongs to God alone; Christian liturgy is participation in Christ’s priestly worship, especially in the Eucharist.","ccc":"CCC 1066–1075, 1135–1199, 2096–2097"}]